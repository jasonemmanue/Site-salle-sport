# === Base de données ===
POSTGRES_DB=salle_sport_db
POSTGRES_USER=sport_user
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://sport_user:changeme@db:5432/salle_sport_db

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Sécurité ===
SECRET_KEY=changeme-generate-a-real-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Admin initial ===
ADMIN_EMAIL=admin@sport.com
ADMIN_PASSWORD=changeme

# === Frontend / Admin ===
# Racine de l'API telle que le NAVIGATEUR la voit (le code ajoute /api/v1).
# Doit correspondre au port publie par le service api dans docker-compose.yml.
NEXT_PUBLIC_API_URL=http://localhost:8010
NEXT_PUBLIC_SITE_NAME=Salle de Sport

# URL de l'API vue depuis le CONTENEUR frontend (rendu serveur Next.js).
# Sous Docker : le nom de service. En dev local hors Docker : laisser vide,
# NEXT_PUBLIC_API_URL sert alors aux deux cotes.
API_INTERNAL_URL=http://api:8000

# === Email SMTP (optionnel) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# === Stockage fichiers ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
