# === Base de données ===
POSTGRES_DB=salle_sport_db
POSTGRES_USER=sport_user
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://sport_user:changeme@db:5432/salle_sport_db

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Sécurité ===
SECRET_KEY=changeme-generate-a-real-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Admin initial ===
ADMIN_EMAIL=admin@sport.com
ADMIN_PASSWORD=changeme

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_NAME=Salle de Sport

# === Email SMTP (optionnel) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# === Stockage fichiers ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
